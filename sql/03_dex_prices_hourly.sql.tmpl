-- Step 2: hourly DEX price statistics per asset and quote token, from the yearly trade tables of
-- step 1 (dex_trades_2023 ... _2026). Scans only those tables (well under 10 GB). Save the result as
-- CSV (Save results -> CSV (Google Drive); the local-file option is limited to small results) as
-- data/dex_prices_hourly.csv.
-- Trades smaller than {min_usd} USD (USD quotes) or {min_eth} ETH (WETH quotes) are dropped.
-- One row per asset, quote token and hour: trade count, volume, the volume-weighted price and the
-- quartiles of the trade prices, in quote-token units (ETH-pegged assets are quoted in WETH).
-- Lending flows can look like trades: depositing the asset and borrowing the quote token in one
-- transaction pairs them at the loan-to-value ratio, and a liquidation pairs them at the liquidation
-- discount. One such flow can dominate an hour's volume-weighted price, so the scripts use the
-- within-hour quartiles instead (make_labels.collapse_dex_quotes).
WITH trades AS (
  SELECT symbol, peg, quote, TIMESTAMP_TRUNC(ts, HOUR) AS hour,
         quote_amount / asset_amount AS price, quote_amount, asset_amount, n_parties
  FROM `{prefix}.dex_trades_*`
  WHERE quote_amount >= IF(peg = 'USD', {min_usd}, {min_eth})
    AND asset_amount > 0
)
SELECT
  symbol,
  quote,
  ANY_VALUE(peg) AS unit,
  FORMAT_TIMESTAMP('%Y-%m-%dT%H:00Z', hour) AS hour,
  COUNT(*) AS n_trades,
  SUM(n_parties) AS n_parties,
  ROUND(SUM(quote_amount), 2) AS volume_quote,
  SUM(quote_amount) / SUM(asset_amount) AS vwap,
  APPROX_QUANTILES(price, 4)[OFFSET(1)] AS p25,
  APPROX_QUANTILES(price, 4)[OFFSET(2)] AS p50,
  APPROX_QUANTILES(price, 4)[OFFSET(3)] AS p75,
  'dex' AS source
FROM trades
GROUP BY symbol, quote, hour
ORDER BY symbol, hour, quote;
